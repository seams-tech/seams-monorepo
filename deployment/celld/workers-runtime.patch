+pub(crate) fn physical_specs() -> anyhow::Result<BTreeMap<String, String>> {
+    let Some(raw) = crate::env_vars::optional::<String>("CELLD_R2_BUCKETS")? else {
+        return Ok(BTreeMap::new());
+    };
+    let specs: BTreeMap<String, String> = serde_json::from_str(&raw)
+        .context("CELLD_R2_BUCKETS must map binding bucket names to physical bucket URIs")?;
+    let mut destinations = std::collections::BTreeSet::new();
+    for (name, spec) in &specs {
+        anyhow::ensure!(
+            !name.is_empty()
+                && name
+                    .bytes()
+                    .all(|c| c.is_ascii_alphanumeric() || c == b'-' || c == b'_'),
+            "invalid R2 binding bucket name"
+        );
+        let physical = spec
+            .strip_prefix("s3://")
+            .or_else(|| spec.strip_prefix("gs://"))
+            .context("physical R2 buckets require s3:// or gs://")?;
+        anyhow::ensure!(
+            !physical.is_empty()
+                && physical.bytes().all(|c| c.is_ascii_lowercase()
+                    || c.is_ascii_digit()
+                    || c == b'-'
+                    || c == b'.'),
+            "physical R2 buckets must name a whole bucket without a prefix"
+        );
+        anyhow::ensure!(
+            destinations.insert(spec),
+            "R2 bindings must use distinct physical buckets"
+        );
+    }
+    Ok(specs)
