{
  "name": "@seams-internal/console-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "migrations"
  ],
  "main": "./dist/esm/index.js",
  "types": "./dist/types/console-server-ts/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/console-server-ts/src/index.d.ts",
      "import": "./dist/esm/index.js",
      "default": "./dist/esm/index.js"
    },
    "./*": {
      "types": "./dist/types/console-server-ts/src/*.d.ts",
      "import": "./dist/esm/*.js",
      "default": "./dist/esm/*.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsrs -p tsconfig.build.json && rolldown -c rolldown.config.ts",
    "build:types": "tsrs -p tsconfig.build.json",
    "type-check": "tsrs --noEmit"
  },
  "dependencies": {
    "@seams-internal/console-shared": "workspace:*",
    "bs58": "6.0.0",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "rolldown": "1.0.0-rc.9",
    "wrangler": "4.111.0"
  }
}
