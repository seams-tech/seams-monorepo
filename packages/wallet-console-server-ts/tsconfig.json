{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022", "dom", "dom.iterable"],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "allowImportingTsExtensions": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "types": ["node"],
    "paths": {
      "@seams-internal/console-shared": ["../console-shared-ts/src/index.ts"],
      "@seams-internal/console-shared/*": ["../console-shared-ts/src/*"],
      "@seams-internal/wallet-console-shared": ["../wallet-console-shared-ts/src/index.ts"],
      "@seams-internal/wallet-console-shared/*": ["../wallet-console-shared-ts/src/*"],
      "@seams-internal/console-server": ["../console-server-ts/src/index.ts"],
      "@seams-internal/console-server/*": ["../console-server-ts/src/*"],
      "@seams-internal/wallet-console-server": ["./src/index.ts"],
      "@seams-internal/wallet-console-server/*": ["./src/*"]
    }
  },
  "include": [
    "src/**/*",
    "../console-shared-ts/src/**/*",
    "../wallet-console-shared-ts/src/**/*",
    "../console-server-ts/src/**/*"
  ],
  "exclude": ["node_modules", "dist"]
}
