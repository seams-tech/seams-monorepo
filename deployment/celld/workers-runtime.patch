+    let mut stores = BTreeMap::new();
+    for (name, spec) in physical_specs()? {
+        let bucket = Bucket::open(&spec, endpoint, region, None, Some("r2"))?;
+        anyhow::ensure!(
+            bucket.backend != fleet.backend || bucket.name != fleet.name,
+            "R2 backups must use a physical bucket distinct from the fleet bucket"
+        );
+        stores.insert(name, PhysicalStore { spec, bucket });
+    }
+    PHYSICAL_STORES
+        .set(stores)
+        .map_err(|_| anyhow::anyhow!("R2 stores already configured"))
+}
+
+pub(crate) fn validate_physical_binding(name: &str, spec: &str) -> anyhow::Result<()> {
