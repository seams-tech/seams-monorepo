{
  "name": "wallet-console",
  "type": "module",
  "private": true,
  "scripts": {
    "vite": "vite --host 127.0.0.1 --port 4005",
    "dev": "vite --config vite.console.config.ts --mode wallet",
    "build": "pnpm run build:platform && pnpm run build:wallet && pnpm run build:marketing",
    "typecheck": "tsrs --noEmit",
    "preview": "vite preview --host 127.0.0.1 --port 4005",
    "dev:platform": "vite --config vite.console.config.ts --mode platform",
    "dev:marketing": "vite --host 127.0.0.1 --port 4008",
    "build:platform": "vite build --config vite.console.config.ts --mode platform",
    "build:wallet": "vite build --config vite.console.config.ts --mode wallet",
    "build:marketing": "vite build",
    "preview:platform": "vite preview --config vite.console.config.ts --mode platform",
    "preview:wallet": "vite preview --config vite.console.config.ts --mode wallet"
  },
  "dependencies": {
    "@fontsource/hanken-grotesk": "^5.2.8",
    "@seams-internal/console-shared": "workspace:*",
    "@seams-internal/grain-field": "workspace:*",
    "@seams-internal/site-navbar": "workspace:*",
    "@seams-internal/wallet-console-shared": "workspace:*",
    "@seams/wallet": "0.19.0",
    "@radix-ui/react-select": "^2.0.0",
    "@tanstack/react-query": "^5.76.1",
    "borsh": "^2.0.0",
    "bs58": "^6.0.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.542.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sonner": "^1.5.0",
    "@seams/wallet-server": "0.19.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^6.0.1",
    "vite": "^8.0.0"
  }
}
