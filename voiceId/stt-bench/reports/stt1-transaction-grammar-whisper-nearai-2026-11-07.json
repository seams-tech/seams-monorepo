  "ruleDefinitions": {
    "ruleW": "text step (lowercase, trim, drop final . , ! ?, drop commas inside digit groups, '.' between letters or letter/digit -> ' dot ', '-' -> ' dash ', '_' -> ' underscore ', then normalize); transfers: words after the first 'to' must have the phonetic_key of exactly one contact, then parse_transfer + render must equal the expected spoken text; multisig: text-step words must equal the expected spoken text",
    "ruleWLiteral": "ruleW, but a '.' between two digits also becomes ' dot '",
    "ruleA": "normalize(transcript) equals the expected spoken text, word for word"
  },
