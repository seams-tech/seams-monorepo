{
  "manifest_version": 3,
  "name": "Seams VoiceID prototype",
  "version": "0.1.0",
  "description": "Local voice approval for the Seams development wallet.",
  "key": "",
  "permissions": ["nativeMessaging"],
  "background": { "service_worker": "bridge.js", "type": "module" },
  "externally_connectable": {
    "matches": ["https://localhost/*", "http://127.0.0.1/*"]
  }
}
