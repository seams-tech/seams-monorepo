# Store a lane-specific copy outside the repository with mode 600.
# pnpm console:deploy:env-prepare -- --lane staging-testnet --values-file <file>
# Apply the generated Console manifest using console:deploy:env-apply.
# Update external values on an existing target using console:deploy:env-update.
# Session, invitation, webhook-encryption, and grant-signing keys are generated
# by the Console pipeline. Use a Cloudflare token scoped to Console resources.
CLOUDFLARE_API_TOKEN=<console-cloudflare-api-token>
CLOUDFLARE_ACCOUNT_ID=<cloudflare-account-id>
STRIPE_API_SK=<stripe-secret-key>
STRIPE_WEBHOOK_SECRET=<stripe-webhook-signing-secret>

# Required when deployment/console/targets.json selects Resend delivery.
RESEND_API_KEY=<console-resend-api-key>

# Optional GitHub OAuth configuration.
# SEAMS_GITHUB_OAUTH_CLIENT_ID=<github-oauth-client-id>
# SEAMS_GITHUB_OAUTH_CLIENT_SECRET=<github-oauth-client-secret>
# SEAMS_GITHUB_OAUTH_CALLBACK_URL=https://wallet.seams.sh/dashboard/login

# Optional Satyr connection. Supply this complete group in the protected file.
# The Console pipeline stores these values in its existing GitHub environment.
# Use separate Ed25519 keys for user assertions and owner provisioning proofs.
# SATYR_DEPLOYMENT_ID=<satyr-deployment-id>
# SATYR_ACCOUNT_SERVICE_TOKEN=<satyr-account-service-token>
# SATYR_ACCOUNT_ASSERTION_ISSUER=<satyr-account-assertion-issuer>
# SATYR_ACCOUNT_ASSERTION_AUDIENCE=<satyr-account-assertion-audience>
# SATYR_ACCOUNT_USER_ASSERTION_KEY_ID=<satyr-account-user-assertion-key-id>
# SATYR_ACCOUNT_USER_ASSERTION_PUBLIC_JWK_JSON=<satyr-account-user-assertion-public-jwk-json>
# SATYR_GOOGLE_OIDC_CLIENT_ID=<satyr-google-oidc-client-id>
# SATYR_SERVICE_ORIGIN=<satyr-service-origin>
# SATYR_PROVISION_PLACEMENT_CELL_ID=<satyr-provision-placement-cell-id>
# SATYR_PROVISION_ENVIRONMENT=<satyr-provision-environment>
# SATYR_PROVISION_TOKEN=<satyr-provision-token>
# ACCOUNT_PROVISION_ASSERTION_ISSUER=<account-provision-assertion-issuer>
# ACCOUNT_PROVISION_ASSERTION_AUDIENCE=<account-provision-assertion-audience>
# ACCOUNT_PROVISION_ASSERTION_KEY_ID=<account-provision-assertion-key-id>
# ACCOUNT_PROVISION_ASSERTION_PRIVATE_JWK_JSON=<account-provision-assertion-private-jwk-json>
