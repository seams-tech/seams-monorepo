{
  "name": "@seams-monorepo/tests",
  "private": true,
  "type": "module",
  "scripts": {
    "check:console-core-wallet-import-boundaries": "node scripts/check-console-core-wallet-import-boundaries.mjs",
    "type-check:fixtures": "tsc -p tsconfig.typecheck.json",
    "type-check:intended": "tsc -p tsconfig.intended.json",
    "type-check:console": "tsc -p tsconfig.console.json",
    "ensure:intended-google-token": "node scripts/ensure-intended-google-token.mjs",
    "setup:intended-google-oidc": "node scripts/setup-intended-google-oidc.mjs",
    "refresh:intended-google-token": "node scripts/refresh-intended-google-token.mjs",
    "seed:intended-local-console": "node scripts/seed-intended-local-console.mjs",
    "test": "pnpm run test:console",
    "test:linked-device:representative": "node scripts/run-intended-isolated.mjs -- e2e/linked-device.operating-path.test.ts --grep 'Passkey→Passkey supports the combined signer profile$'",
    "test:linked-device": "node scripts/run-intended-isolated.mjs -- e2e/linked-device.operating-path.test.ts",
    "test:linked-device:external": "pnpm run ensure:intended-google-token && SEAMS_LINKED_DEVICE_E2E=1 playwright test -c playwright.linked-device.config.ts --reporter=line",
    "test:intended": "pnpm run type-check:intended && node scripts/run-intended-isolated.mjs",
    "test:intended:ci": "pnpm run test:intended",
    "test:intended:external": "pnpm run type-check:intended && pnpm run ensure:intended-google-token && SEAMS_LINKED_DEVICE_E2E=1 playwright test -c playwright.intended.config.ts --reporter=line",
    "test:console": "pnpm run type-check:console && playwright test -c playwright.console.config.ts --reporter=line",
    "test:unit": "playwright test -c playwright.unit.config.ts",
    "test:source-guards": "pnpm run check:console-core-wallet-import-boundaries",
    "test:relayer": "playwright test -c playwright.relayer.config.ts --reporter=line",
    "show-report": "playwright show-report"
  },
  "devDependencies": {
    "@seams-internal/console-shared": "workspace:*",
    "@seams-internal/wallet-console-shared": "workspace:*",
    "@seams-internal/console-server": "workspace:*",
    "@seams-internal/wallet-console-server": "workspace:*",
    "@seams/wallet-server": "0.7.1",
    "@noble/curves": "^2.0.1",
    "@noble/ed25519": "^2.1.0",
    "@playwright/test": "^1.40.0",
    "@simplewebauthn/server": "^13.2.2",
    "@types/express": "^4.17.23",
    "express": "^4.21.2",
    "viem": "^2.38.6",
    "@seams/wallet": "0.7.1"
  }
}
