+fn validate_external_object_owners(
+    primary: &LoadedDeployment,
+    cohosted: &[LoadedDeployment],
+) -> anyhow::Result<()> {
+    let scripts: BTreeMap<_, _> = std::iter::once(primary)
+        .chain(cohosted)
+        .map(|deployment| {
+            (
+                deployment.script_name.as_str(),
+                &deployment.options.do_classes,
+            )
+        })
+        .collect();
+    for deployment in std::iter::once(primary).chain(cohosted) {
+        for binding in &deployment.external_objects {
+            let classes = scripts.get(binding.script.as_str()).ok_or_else(|| {
+                anyhow!(
+                    "object binding {} has no owner script {}",
+                    binding.name,
+                    binding.script
+                )
+            })?;
+            anyhow::ensure!(
+                classes.contains(&binding.class),
+                "object binding {} targets class {} not owned by script {}",
+                binding.name,
+                binding.class,
+                binding.script
+            );
+        }
+    }
+    Ok(())
+}
