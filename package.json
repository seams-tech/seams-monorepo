{
  "name": "seams-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "arc-wallets:generate": "node ./scripts/arc-test-wallets.mjs generate",
    "arc-wallets:addresses": "node ./scripts/arc-test-wallets.mjs addresses",
    "arc-wallets:sweep": "node ./scripts/arc-test-wallets.mjs sweep",
    "install-all": "pnpm -r install",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "caddy": "pnpm -C apps/seams-site caddy",
    "site": "node ./scripts/stop-local-site-listeners.mjs && pnpm run site:serve",
    "site:serve": "concurrently --kill-others --names caddy,site,console,docs \"pnpm run caddy\" \"VITE_SITE_ORIGIN=http://localhost:4001 VITE_DOCS_ORIGIN=https://docs.localhost:4003 node ./scripts/start-local-site.mjs\" \"VITE_SITE_ORIGIN=http://localhost:4001 VITE_CONSOLE_BASE_URL=https://localhost:4101 VITE_RELAYER_URL=https://localhost:4101 VITE_WALLET_ORIGIN=https://localhost:4002 pnpm -C apps/wallet-console dev\" \"VITE_SITE_ORIGIN=http://localhost:4001 VITE_DOCS_ORIGIN=https://docs.localhost:4003 pnpm run docs:preview\"",
    "deploy:backend": "node ./scripts/deploy-backend.mjs",
    "deploy:frontend": "node ./scripts/deploy-surface.mjs",
    "tenant:cutover": "node ./scripts/tenant-cutover.mjs",
    "router:deploy:browser-evidence": "pnpm -C tests exec playwright test -c playwright.router-ab-deployed-evidence.config.ts --reporter=line",
    "router:deploy:keygen": "node ./deployment/wallet-system/scripts/generate-deployment-keys.mjs",
    "console:deploy:env-prepare": "node ./scripts/console-deployment-environment.mjs prepare",
    "console:deploy:env-apply": "node ./scripts/console-deployment-environment.mjs apply",
    "console:deploy:env-update": "node ./scripts/console-deployment-environment.mjs update",
    "console:deploy": "node ./scripts/dispatch-deployment-workflow.mjs console",
    "wallet-system:deploy:env-prepare": "node ./deployment/wallet-system/scripts/generate-github-env-values.mjs --prepare --component wallet-system",
    "wallet-system:deploy:env-apply": "node ./deployment/wallet-system/scripts/generate-github-env-values.mjs --apply --component wallet-system",
    "wallet-system:deploy:env-update": "node ./deployment/wallet-system/scripts/apply-github-external-values.mjs --component wallet-system",
    "wallet-system:deploy": "node ./scripts/dispatch-deployment-workflow.mjs wallet-system",
    "site:deploy:env-apply": "node ./deployment/wallet-system/scripts/generate-github-env-values.mjs --apply --component site",
    "site:deploy:env-update": "node ./deployment/wallet-system/scripts/apply-github-external-values.mjs --component site",
    "voiceId:demo": "pnpm -C voiceId dev:all",
    "build": "pnpm -C packages/console-server-ts build && pnpm -C packages/wallet-console-server-ts build && pnpm -C apps/wallet-console build && pnpm -C apps/seams-site build",
    "type-check:router-server": "pnpm -C packages/console-server-ts build:types && pnpm -C packages/wallet-console-server-ts type-check && pnpm -C packages/wallet-console-server-ts build:types",
    "type-check:app": "pnpm -C packages/console-shared-ts type-check && pnpm -C packages/wallet-console-shared-ts type-check && pnpm -C apps/seams-site typecheck && pnpm -C apps/wallet-console typecheck",
    "type-check": "pnpm type-check:router-server && pnpm type-check:app",
    "check": "pnpm lint && pnpm type-check && pnpm -C tests check:console-core-wallet-import-boundaries",
    "router": "node ./scripts/local-wallet/dev-local-workers.mjs --mode logs",
    "router:multiplex": "node ./scripts/local-wallet/dev-local-workers.mjs --mode multiplex",
    "router:init": "seams-wallet-server-local-init --root .",
    "router:reset": "node ./scripts/local-wallet/reset-local-router.mjs",
    "recovery:local": "node ./scripts/local-wallet/recovery-local.mjs",
    "wallet-system:local": "seams-wallet-server-local",
    "gateway:server": "pnpm -C packages/wallet-console-server-ts d1:local:dev",
    "docs:preview": "pnpm -C apps/seams-site exec vite preview --outDir ../../.artifacts/wallet-docs --host 127.0.0.1 --port 4006",
    "test": "pnpm test:unit",
    "test:unit": "pnpm -C tests test:unit",
    "test:console": "pnpm -C tests test:console",
    "test:relayer": "pnpm -C tests test:relayer"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^24.1.0",
    "concurrently": "^9.1.2",
    "dotenv": "^16.5.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.0.0",
    "typescript-eslint": "^8.0.0",
    "viem": "^2.38.6",
    "wrangler": "4.111.0"
  },
  "packageManager": "pnpm@11.11.0+sha512.4463f65fd80ed80d69bc1d4bf163ee94f605c7380fc318bb5b2ebe15f8cd12d49c51a4d59e951b401e764d3b6ca751cbf51bc50ed7001a6bcb4935e684c34882",
  "dependencies": {
    "@seams/wallet": "0.5.33",
    "@seams/wallet-server": "0.5.33"
  }
}
