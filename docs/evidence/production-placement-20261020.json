  "findings": [
    "The placement-only arm did not meet the latency target or show an improvement over either control median.",
    "Observed wallet objects remained split between Hong Kong and Singapore; this was not a fully co-located Singapore test.",
    "APAC Runtime and Deriver A database primaries remain Hong Kong. Console, Deriver B and Signing Worker primaries are Singapore.",
    "Production uses one shared custody Worker set across regional Gateways and runtimes.",
    "Worker placement settings cannot establish the actual locations of wallet objects or database primaries.",
    "Existing relocation requires owner approval and rejects same-region source and destination."
  ],
  "limitations": [
    "Nine wallets per sequential arm do not isolate time variation or support a tail guarantee.",
    "Four Worker placements changed together; this cannot assign an effect to one Worker.",
    "Host observations are scoped to the measurement window and may omit requests or include other concurrent traffic.",
    "Cloudflare placement hints are best effort. A successful upload does not prove co-location.",
    "The regional data-preserving migration is not completed by this experiment."
  ],
  "causeTable": [
    {
      "cause": "Touch ID interaction included in target",
      "status": "excluded by the SDK timing boundary"
    },
    {
      "cause": "SDK version or local iframe changes between arms",
      "status": "excluded by fixed 0.15.2 and hosted manifest checks"
    },
    {
      "cause": "Worker placement alone resolves the delay",
      "status": "not supported by this experiment"
    },
    {
      "cause": "Mixed object and D1 locations contribute",
      "status": "plausible; full co-location was not achieved or tested"
    },
    {
      "cause": "Hosted storage or dispatch variation",
      "status": "remains plausible"
    }
  ],
  "nextRequirements": [
    "Use a narrower APAC object placement hint and verify actual destinations.",
    "Preserve existing ownership and authorization while enabling same-region infrastructure migration.",
    "Provide regional custody storage and routing before claiming US or Europe co-location.",
    "Verify database primaries, object hosts, successful existing-wallet signing, and the exact latency boundary after migration."
  ],
